# Copy to .env in the project root; do not commit real credentials.
PORT=3001
NODE_ENV=development
# Use different long random secrets in production (for example: openssl rand -base64 48)
SESSION_SECRET=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-a-different-random-encryption-secret
# Optional automatic first-run superuser provisioning. If these are unset, use ADMIN_SETUP_KEY below and the first-run setup form.
# ADMIN_EMAIL=admin@example.com
# ADMIN_NAME=Workspace Admin
# ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
# Required for first-run setup through the login page; generate a unique random value and remove it after setup.
ADMIN_SETUP_KEY=replace-with-a-one-time-random-setup-key
# Optional: store app-data.json outside the repository on a protected persistent volume.
# DATA_DIR=/absolute/path/to/private/app-data
# Behind nginx/Caddy set TRUST_PROXY=1 so rate limiting sees real client IPs.
# TRUST_PROXY=1
# In production cookies are Secure (HTTPS only). If you serve plain HTTP on an IP, set COOKIE_SECURE=false (not recommended).
# COOKIE_SECURE=false
# Optional URL sent as OpenRouter HTTP-Referer.
# APP_URL=https://analytics.example.com
